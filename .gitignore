# Compiled Python bytecode. Two .pyc files under backend-patches/ were tracked
# by accident, so every run of those services dirtied the working tree with an
# unreadable binary diff. The sources next to them are what matters.
__pycache__/
*.py[cod]

# Encrypted credential archives — must never reach a remote
secrets-backup/

# Live-managed by Claude Code; accumulates local command text incl. credentials
.claude/settings.json

# Second-factor bypass. auth-access.conf carries a live MASTER_OTP, which its
# own header describes as a full 2FA bypass: anyone with the code, coming from
# an allow-listed IP, can finish sign-in for any account whose password they
# have. The GitHub remote is a public repo and git history is forever, so
# neither the code nor the script that applies it can ever be committed.
auth-access.conf
apply-auth-access.sh

# Build output, same as `dist` above -- 53 MB regenerated by every deploy.
dist-deploy/

# Stale pre-rebrand build output ("Acepeak"), regenerated by every deploy the
# same as `dist` above -- committed once by accident, now removed and ignored
# so it can't happen again.
dist-acepeak/
