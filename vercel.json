{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api2.mycountrymobile.com/api/:path*" },
    {
      "source": "/Organisations/:path*",
      "destination": "https://api2.mycountrymobile.com/Organisations/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
