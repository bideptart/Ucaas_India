# Copy to .env for local development, or set these in your hosting platform
# (Vercel: Project -> Settings -> Environment Variables).
#
# The build reads .env from /etc/mycountrymobile-web on the production host and
# from the project root everywhere else. Anything left unset is baked into the
# bundle as `undefined`, so a variable a feature needs is missing at runtime
# with no error to point at it.

# Leave unset unless this deployment runs on a domain the API allowlists.
# Empty means API calls are same-origin (/api/...), which the dev server and
# vercel.json proxy to the API host so the browser never makes a cross-origin
# request. Setting an absolute URL opts back into direct calls, and those are
# CORS-blocked from any host the API does not recognise. See DEPLOYMENT.md.
VITE_API_BASE_URL=

# Where the dev server proxies /api. Build-time only, not exposed to the app.
VITE_API_PROXY_TARGET=https://api2.mycountrymobile.com

# Which organisation's branding to load. Defaults to the domain the app is
# served from; preview and localhost hosts fall back to QA. Set this when a
# deployment should follow one specific organisation.
VITE_ORG_DOMAIN=https://qa.mycountrymobile.com

# Set to "production" to silence console.log in the built app.
VITE_APP_ENV=development

# Optional integrations - features that use them stay inert while unset.
VITE_NOTIFICATION_SOCKET_URL=
VITE_AI_SOCKET_URL=
VITE_AI_URL=
VITE_AGENTIC_API_URL=
VITE_PAYPAL_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_HUBSPOT_CLIENT_ID=
VITE_HUBSPOT_SCOPE=
VITE_HUBSPOT_REDIRECT_URL=
VITE_TEMPLATE_BASE_URL=
VITE_WHATSAPP_CHAT_TOKEN=
VITE_WHITEBOARD_BASE_URL=
VITE_APP_DOMAIN=
VITE_APP_SLUG=
